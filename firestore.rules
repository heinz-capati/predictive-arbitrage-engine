rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Raw unstructured social & e-commerce ingestion signals
    match /raw_signals/{signalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Daily computed MAD Z-Score, Momentum Decay, and Newsvendor Arbitrage scores
    match /arbitrage_scores/{scoreId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

